# Copy this file to .env and fill in the values yourself.
# Never paste secrets into chat, commit messages, or ask an AI assistant to fill this in.
# Docker Compose env files do NOT strip inline "# comment" text, so every
# comment here is on its own line.

# --- Slack (Socket Mode) ---
# Bot User OAuth Token, from Slack app "OAuth & Permissions" page. Starts with xoxb-.
SLACK_BOT_TOKEN=

# App-Level Token with the connections:write scope, from "Basic Information" -> App-Level Tokens.
# Starts with xapp-.
SLACK_APP_TOKEN=

# Signing Secret, from Slack app "Basic Information" page.
SLACK_SIGNING_SECRET=

# --- Anthropic (Claude) ---
# API key from https://console.anthropic.com/.
ANTHROPIC_API_KEY=

# Claude model ID to use. Check https://platform.claude.com/docs/en/about-claude/models/overview
# for the current list, since model names and retirement dates change over time.
# Default below is a reasonable speed/intelligence balance as of this writing.
CLAUDE_MODEL=claude-sonnet-5-5

# --- DataHub ---
# Base GMS URL as reachable from this container. In this deployment GMS is
# proxied by the DataHub frontend, so this includes the /api/gms path, e.g.
# https://dev-datahub.avenews.io/api/gms
# Do NOT set a DATAHUB_GMS_TOKEN here: this bot never uses a shared/service
# DataHub token. Each Slack user's own personal access token is used instead.
DATAHUB_GMS_URL=

# Base UI URL, used to build links to DataHub entities in Slack answers, e.g.
# https://dev-datahub.avenews.io
DATAHUB_UI_URL=

# --- Storage / encryption ---
# Secret used to encrypt each user's DataHub token at rest. Any long random
# string works, e.g. generate one with: openssl rand -hex 32
# Changing this after tokens are already stored will make them undecryptable;
# affected users will need to run /datahub-connect again.
ENCRYPTION_KEY=

# Path to the SQLite database file. Should point inside the mounted volume
# (see docker-compose.yml) so linked tokens survive container restarts.
DB_PATH=/data/bot.db

# Path to the log file the DataHub MCP subprocess writes its (very chatty)
# stderr output to. Kept separate from the bot's own stdout logs.
MCP_LOG_FILE=/data/mcp-server.log

# --- Behavior ---
# Where answers are posted when asked via @mention in a channel:
#   private = ephemeral reply visible only to the person who asked (default)
#   thread  = visible to everyone in the channel thread
# Chosen default is "private" because different people can have different
# DataHub permissions, and a public thread reply could leak that asymmetry.
ANSWER_VISIBILITY=private

# Maximum number of Claude <-> DataHub tool-use round trips per question,
# to bound cost and latency.
MAX_TOOL_ROUNDS=6

# Maximum characters of a single tool result kept before truncating it, to
# avoid blowing up token usage on very large DataHub responses.
TOOL_RESULT_MAX_CHARS=4000
