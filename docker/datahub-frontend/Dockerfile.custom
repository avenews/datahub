FROM acryldata/datahub-frontend-react:v1.7.0.1 AS base

USER root

RUN apk add --no-cache zip unzip

# --- Patch datahub-web-react assets JAR (React app) ---
RUN set -eu; \
    web_react_jar="$(find /datahub-frontend/lib -maxdepth 1 -name 'datahub-web-react-*-assets.jar' -print -quit)"; \
    web_react_jar_name="$(basename "$web_react_jar")"; \
    mkdir -p /tmp/react-assets && \
    cd /tmp/react-assets && \
    unzip -q "$web_react_jar" && \
    rm -rf /tmp/react-assets/public/*.html \
           /tmp/react-assets/public/assets \
           /tmp/react-assets/public/manifest.json \
           /tmp/react-assets/public/robots.txt \
           /tmp/react-assets/public/browserconfig.xml && \
        rm "$web_react_jar" && \
        zip -qr "/datahub-frontend/lib/$web_react_jar_name" .

COPY datahub-web-react/dist/ /tmp/react-assets/public/

RUN set -eu; \
    web_react_jar="$(find /datahub-frontend/lib -maxdepth 1 -name 'datahub-web-react-*-assets.jar' -print -quit)"; \
    rm "$web_react_jar" && \
    cd /tmp/react-assets && \
    zip -qr "$web_react_jar" . && \
    rm -rf /tmp/react-assets

# --- Patch datahub-frontend assets JAR (Play assets — takes priority for logo/favicon) ---
RUN set -eu; \
    frontend_jar="$(find /datahub-frontend/lib -maxdepth 1 -name 'datahub-frontend-*-assets.jar' -print -quit)"; \
    frontend_jar_name="$(basename "$frontend_jar")"; \
    mkdir -p /tmp/fe-assets && \
    cd /tmp/fe-assets && \
    unzip -q "$frontend_jar" && \
    rm "$frontend_jar" && \
    zip -qr "/datahub-frontend/lib/$frontend_jar_name" .

COPY datahub-web-react/public/assets/logo.png /tmp/fe-assets/public/assets/logo.png
COPY datahub-web-react/public/assets/icons/favicon.ico /tmp/fe-assets/public/assets/icons/favicon.ico

RUN set -eu; \
    frontend_jar="$(find /datahub-frontend/lib -maxdepth 1 -name 'datahub-frontend-*-assets.jar' -print -quit)"; \
    rm "$frontend_jar" && \
    cd /tmp/fe-assets && \
    zip -qr "$frontend_jar" . && \
    rm -rf /tmp/fe-assets

USER datahub
