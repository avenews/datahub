# =============================================================================
# DataHub Production Environment Variables
# Copy this to .env and fill in all CHANGEME values before running docker compose
# NEVER commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# IMAGE VERSIONS
# All services use 'quickstart' — only coordinated tag available across images
# NOTE: datahub-actions uses 'quickstart-locked' (set in Dockerfile.custom)
#       because 'quickstart' has a broken/corrupted venv (59 broken packages)
# -----------------------------------------------------------------------------
DATAHUB_VERSION=quickstart

# -----------------------------------------------------------------------------
# SECRETS — generate with: openssl rand -base64 32 (must be 32+ chars each)
# DATAHUB_SECRET is used by Play 3 for session signing — will FAIL on startup
# if less than 32 chars or set to 'changeme'
# -----------------------------------------------------------------------------
DATAHUB_SECRET=CHANGEME
DATAHUB_TOKEN_SERVICE_SIGNING_KEY=CHANGEME
DATAHUB_TOKEN_SERVICE_SALT=CHANGEME

# -----------------------------------------------------------------------------
# DATABASE
# IMPORTANT: MYSQL_ROOT_PASSWORD MUST be 'datahub' — the system-update job
# connects as root with this password for schema migrations. Changing it will
# cause system-update to fail with "Access denied for user root".
# -----------------------------------------------------------------------------
MYSQL_PASSWORD=CHANGEME
MYSQL_ROOT_PASSWORD=datahub

# -----------------------------------------------------------------------------
# INGESTION CLI VERSION
# Version of acryl-datahub used for dynamic venv ingestion (non-bundled sources)
# Check available versions: https://pypi.org/project/acryl-datahub/#history
# For custom sources (zoho-crm, zoho-books, posthog) use CLI Version: bundled
# -----------------------------------------------------------------------------
UI_INGESTION_DEFAULT_CLI_VERSION=1.6.0.6rc2

# -----------------------------------------------------------------------------
# CUSTOM FE IMAGE
# -----------------------------------------------------------------------------
DATAHUB_FRONTEND_IMAGE=CHANGEME
DATAHUB_FRONTEND_VERSION=latest

# -----------------------------------------------------------------------------
# CONFLUENT VERSION
# -----------------------------------------------------------------------------
DATAHUB_CONFLUENT_VERSION=7.9.2

# -----------------------------------------------------------------------------
# SSO / OIDC
# AUTH_OIDC_ENABLED is set to "true" in docker-compose.override.yml
# AUTH_OIDC_DISCOVERY_URI defaults to Google — override for other providers
# AUTH_OIDC_BASE_URL must match the public URL users access DataHub at
# -----------------------------------------------------------------------------
AUTH_OIDC_CLIENT_ID=CHANGEME
AUTH_OIDC_CLIENT_SECRET=CHANGEME
AUTH_OIDC_BASE_URL=https://CHANGEME.example.com